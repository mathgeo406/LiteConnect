<Window x:Class="LiteConnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LiteConnect.App.ViewModels"
        xmlns:views="clr-namespace:LiteConnect.App.Views"
        xmlns:conv="clr-namespace:LiteConnect.App.Converters"
        Title="LiteConnect"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Shell.Background}">

    <Window.Resources>
        <!-- ── Colour tokens ─────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="Shell.Background"          Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Shell.Panel.Background"    Color="#252526"/>
        <SolidColorBrush x:Key="Shell.Border"              Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Shell.Foreground"          Color="#D4D4D4"/>
        <SolidColorBrush x:Key="Shell.Foreground.Muted"    Color="#858585"/>
        <SolidColorBrush x:Key="Shell.Accent"              Color="#007ACC"/>
        <SolidColorBrush x:Key="Shell.Accent.Hover"        Color="#1C97EA"/>
        <SolidColorBrush x:Key="Tab.Header.Background"     Color="#2D2D2D"/>
        <SolidColorBrush x:Key="Tab.Header.Active"         Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Tab.Header.Hover"          Color="#3E3E3E"/>
        <SolidColorBrush x:Key="StatusBar.Background"      Color="#007ACC"/>
        <SolidColorBrush x:Key="Toolbar.Background"        Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Input.Background"          Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Input.Border"              Color="#555555"/>

        <!-- ── Converters ────────────────────────────────────────────────── -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter      x:Key="InverseBool"/>

        <!-- ── Menu / toolbar button style ───────────────────────────────── -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource Shell.Foreground}"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Padding"      Value="8,4"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Shell.Accent.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Closable tab header ───────────────────────────────────────── -->
        <Style x:Key="ClosableTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource Tab.Header.Background}"
                                BorderBrush="{DynamicResource Shell.Border}"
                                BorderThickness="1,1,1,0"
                                Padding="10,5"
                                Margin="0,0,2,0"
                                CornerRadius="3,3,0,0">
                            <Border.ContextMenu>
                                <ContextMenu Background="{DynamicResource Shell.Panel.Background}"
                                             Foreground="{DynamicResource Shell.Foreground}"
                                             BorderBrush="{DynamicResource Shell.Border}">
                                    <MenuItem Header="Reconnect"
                                              Command="{Binding ReconnectCommand}"/>
                                    <MenuItem Header="Disconnect"
                                              Command="{Binding DisconnectCommand}"/>
                                    <MenuItem Header="Full Screen"
                                              Command="{Binding FullScreenCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Properties…"
                                              Command="{Binding PropertiesCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Close Tab"
                                              Command="{Binding CloseCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusIcon}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="HeaderText"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Shell.Foreground.Muted}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           MaxWidth="160"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Content="✕"
                                        Command="{Binding DataContext.CloseTabCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="8,0,0,0"
                                        Padding="2,0"
                                        FontSize="10"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{DynamicResource Shell.Foreground.Muted}"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        ToolTip="Close tab">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#C04040"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource Tab.Header.Active}"/>
                                <Setter TargetName="HeaderText" Property="Foreground"
                                        Value="{DynamicResource Shell.Foreground}"/>
                                <Setter TargetName="HeaderText" Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource Tab.Header.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  Root layout: Menu → Toolbar → Content → StatusBar                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <DockPanel LastChildFill="True">

        <!-- ── Menu bar ──────────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource Shell.Panel.Background}"
              Foreground="{DynamicResource Shell.Foreground}"
              BorderBrush="{DynamicResource Shell.Border}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Foreground="{DynamicResource Shell.Foreground}">
                <MenuItem Header="New _Connection…"
                          InputGestureText="Ctrl+N"
                          Command="{Binding TreeViewModel.NewConnectionCommand}"/>
                <MenuItem Header="New _Folder…"
                          Command="{Binding TreeViewModel.NewGroupCommand}"/>
                <Separator/>
                <MenuItem Header="_Import Connections…"/>
                <MenuItem Header="_Export Connections…"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="MenuItem_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="{DynamicResource Shell.Foreground}">
                <MenuItem Header="_Find…"             InputGestureText="Ctrl+F"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource Shell.Foreground}">
                <MenuItem Header="Connection _Tree"   IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="_Status Bar"        IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="{DynamicResource Shell.Foreground}">
                <MenuItem Header="_Security &amp; Encryption…"
                          Command="{Binding OpenSecuritySettingsCommand}"/>
                <MenuItem Header="_Settings…"
                          InputGestureText="Ctrl+,"
                          Command="{Binding OpenSecuritySettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="{DynamicResource Shell.Foreground}">
                <MenuItem Header="_About LiteConnect…"/>
            </MenuItem>
        </Menu>

        <!-- ── Quick Connect toolbar ─────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Toolbar.Background}"
                BorderBrush="{DynamicResource Shell.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <TextBlock Text="Quick Connect:"
                           Foreground="{DynamicResource Shell.Foreground.Muted}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"/>
                <ComboBox DockPanel.Dock="Right"
                          ItemsSource="{Binding ProtocolOptions}"
                          SelectedItem="{Binding QuickConnectProtocol}"
                          Width="70"
                          Margin="4,0"
                          Background="{DynamicResource Input.Background}"
                          Foreground="{DynamicResource Shell.Foreground}"
                          BorderBrush="{DynamicResource Input.Border}"
                          VerticalContentAlignment="Center"
                          FontSize="12"/>
                <Button DockPanel.Dock="Right"
                        Content="Connect"
                        Command="{Binding QuickConnectCommand}"
                        Margin="4,0,0,0"
                        Padding="12,4"
                        Background="{DynamicResource Shell.Accent}"
                        Foreground="White"
                        BorderBrush="Transparent"
                        FontSize="12"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Shell.Accent.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox Text="{Binding QuickConnectHost, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource Input.Background}"
                         Foreground="{DynamicResource Shell.Foreground}"
                         CaretBrush="{DynamicResource Shell.Foreground}"
                         BorderBrush="{DynamicResource Input.Border}"
                         BorderThickness="1"
                         Padding="6,4"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         MinWidth="200">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding QuickConnectCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- ── Status bar ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBar.Background}"
                Padding="8,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0">
                    <Run Text="{Binding OpenSessionCount, Mode=OneWay}"/>
                    <Run Text=" session(s)"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Main content: tree | splitter | tabs ──────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Connection tree panel -->
                <ColumnDefinition Width="250" MinWidth="150" MaxWidth="600"/>
                <!-- Resizable splitter -->
                <ColumnDefinition Width="Auto"/>
                <!-- Session tab area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Connection tree — bound to TreeViewModel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Shell.Panel.Background}"
                    BorderBrush="{DynamicResource Shell.Border}"
                    BorderThickness="0,0,1,0"
                    DataContext="{Binding TreeViewModel}">
                <DockPanel>
                    <!-- Tree panel toolbar -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource Shell.Panel.Background}"
                            BorderBrush="{DynamicResource Shell.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="4,4">
                        <DockPanel>
                            <TextBlock Text="CONNECTIONS"
                                       Foreground="{DynamicResource Shell.Foreground.Muted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="📁" ToolTip="New Folder"
                                        Command="{Binding NewGroupCommand}"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Padding="6,2" FontSize="13"/>
                                <Button Content="+" ToolTip="New Connection"
                                        Command="{Binding NewConnectionCommand}"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Padding="6,2" FontSize="14"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Search box bound to SearchQuery -->
                    <Border DockPanel.Dock="Top"
                            Padding="6,4"
                            BorderBrush="{DynamicResource Shell.Border}"
                            BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Input.Background}"
                                 Foreground="{DynamicResource Shell.Foreground}"
                                 CaretBrush="{DynamicResource Shell.Foreground}"
                                 BorderBrush="{DynamicResource Input.Border}"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="12">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="HintBrush2" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Search connections…"
                                                           Foreground="{DynamicResource Shell.Foreground.Muted}"
                                                           FontSize="12"
                                                           Margin="2,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource HintBrush2}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Real data-bound TreeView -->
                    <TreeView x:Name="ConnectionTree"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="ConnectionTree_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource Shell.Foreground}"
                              FontSize="13"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">

                        <TreeView.Resources>
                            <!-- HierarchicalDataTemplate for group nodes -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Shell.Foreground}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded"      Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected"      Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Foreground"      Value="{DynamicResource Shell.Foreground}"/>
                                <Setter Property="Padding"         Value="4,3"/>
                                <Setter Property="Background"      Value="Transparent"/>

                                <!-- Double-click opens a connection -->
                                <EventSetter Event="MouseDoubleClick"
                                             Handler="TreeItem_MouseDoubleClick"/>

                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Shell.Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <!-- Right-click context menu -->
                        <TreeView.ContextMenu>
                            <ContextMenu Background="{DynamicResource Shell.Panel.Background}"
                                         Foreground="{DynamicResource Shell.Foreground}"
                                         BorderBrush="{DynamicResource Shell.Border}">
                                <MenuItem Header="New Connection…"
                                          Command="{Binding PlacementTarget.DataContext.NewConnectionCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="New Folder"
                                          Command="{Binding PlacementTarget.DataContext.NewGroupCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Edit…"
                                          Command="{Binding PlacementTarget.DataContext.EditNodeCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Rename"
                                          Command="{Binding PlacementTarget.DataContext.EditNodeCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Delete"
                                          Command="{Binding PlacementTarget.DataContext.DeleteNodeCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Foreground="#FF6060"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>

                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Grid splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Shell.Border}"
                          Cursor="SizeWE"/>

            <!-- Session tab area -->
            <Grid Grid.Column="2">
                <!-- Welcome screen (visible when no tabs are open) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ActiveTab, Converter={StaticResource BoolToVisibility},
                                                 ConverterParameter=inverse}">
                    <Image Source="pack://application:,,,/Assets/app.png"
                           Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                    <TextBlock Text="LiteConnect"
                               Foreground="{DynamicResource Shell.Foreground}"
                               FontSize="32"
                               FontWeight="Light"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Double-click a connection to open a session."
                               Foreground="{DynamicResource Shell.Foreground.Muted}"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                    <Button Content="New Connection…"
                            Command="{Binding TreeViewModel.NewConnectionCommand}"
                            Margin="0,24,0,0"
                            Padding="16,8"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Shell.Accent}"
                            Foreground="White"
                            BorderBrush="Transparent"
                            FontSize="13"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Shell.Accent.Hover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Tab control (visible when tabs exist) -->
                <TabControl ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding ActiveTab}"
                            Background="{DynamicResource Shell.Background}"
                            BorderBrush="{DynamicResource Shell.Border}"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ClosableTabItemStyle}"
                            Visibility="{Binding OpenSessionCount,
                                                 Converter={StaticResource BoolToVisibility}}">
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:RdpSessionViewModel}">
                            <views:RdpTabView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SshSessionViewModel}">
                            <views:SshTabView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PlaceholderTabViewModel}">
                            <Border Background="{DynamicResource Shell.Background}">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Shell.Foreground.Muted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </TabControl.Resources>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
