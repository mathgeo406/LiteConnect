<Window x:Class="LiteConnect.App.Views.HostKeyVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Host Key Verification"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#D4D4D4">

    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="TxtHeader"
                       Text="🔑 Verify SSH Server Host Key"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#D4D4D4"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtDescription"
                       TextWrapping="Wrap"
                       Foreground="#B0B0B0"
                       FontSize="12.5"
                       Margin="0,0,0,14"/>

            <Border Background="#252526"
                    BorderBrush="#3C3C3C"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" Foreground="#858585" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtHost" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Key Algorithm:" Foreground="#858585" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAlgorithm" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fingerprint:" Foreground="#858585" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFingerprint"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="#4EC9B0"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LblPrevFingerprint"
                               Text="Previous Key:" Foreground="#F14C4C" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPrevFingerprint"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="#F14C4C"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reject"
                        Width="95"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        Background="#3C3C3C"
                        Foreground="#D4D4D4"
                        BorderBrush="#555555"
                        IsCancel="True"
                        Click="BtnReject_Click"/>

                <Button Content="Accept Once"
                        Width="110"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        Background="#3C3C3C"
                        Foreground="#D4D4D4"
                        BorderBrush="#555555"
                        Click="BtnAcceptOnce_Click"/>

                <Button Content="Accept &amp; Remember"
                        Width="145"
                        Padding="10,6"
                        Background="#007ACC"
                        Foreground="White"
                        BorderBrush="#007ACC"
                        IsDefault="True"
                        Click="BtnAcceptRemember_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
