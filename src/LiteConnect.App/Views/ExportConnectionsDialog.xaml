<Window x:Class="LiteConnect.App.Views.ExportConnectionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Connections"
        Width="480" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#D4D4D4">

    <DockPanel Margin="20,16">
        <!-- Bottom Buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnExport"
                    Content="Export…"
                    Width="100" Padding="8,6"
                    Margin="0,0,10,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="Transparent"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="BtnExport_Click"/>
            <Button Content="Cancel"
                    Width="90" Padding="8,6"
                    Background="#2D2D2D"
                    Foreground="#D4D4D4"
                    BorderBrush="#3C3C3C"
                    Cursor="Hand"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="EXPORT SCOPE"
                       FontSize="11" FontWeight="SemiBold" Foreground="#007ACC"
                       Margin="0,0,0,8"/>

            <RadioButton x:Name="RbScopeAll"
                         Content="All connections"
                         Foreground="#D4D4D4"
                         Margin="0,0,0,6"
                         IsChecked="True"/>
            <RadioButton x:Name="RbScopeSelected"
                         Content="Selected folder / connection"
                         Foreground="#D4D4D4"
                         Margin="0,0,0,14"/>

            <TextBlock Text="EXPORT FORMAT"
                       FontSize="11" FontWeight="SemiBold" Foreground="#007ACC"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="CboExportFormat"
                      Height="28"
                      Margin="0,0,0,14"
                      SelectionChanged="CboExportFormat_SelectionChanged">
                <ComboBoxItem Content="Encrypted Bundle (.lcx)" Tag="EncryptedLcx" IsSelected="True"/>
                <ComboBoxItem Content="Sessions Only — No Credentials (.lcx)" Tag="SessionsOnlyLcx"/>
                <ComboBoxItem Content="CSV Spreadsheet (.csv)" Tag="Csv"/>
                <ComboBoxItem Content="mRemoteNG XML (.xml)" Tag="MRemoteNGXml"/>
            </ComboBox>

            <TextBlock Text="OPTIONS"
                       FontSize="11" FontWeight="SemiBold" Foreground="#007ACC"
                       Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkIncludeCredentials"
                      Content="Include credentials (passwords &amp; passphrases)"
                      Foreground="#D4D4D4"
                      IsChecked="True"
                      Margin="0,0,0,6"
                      Checked="ChkIncludeCredentials_Changed"
                      Unchecked="ChkIncludeCredentials_Changed"/>
            <CheckBox x:Name="ChkIncludeSshKeys"
                      Content="Embed SSH private key files into bundle"
                      Foreground="#D4D4D4"
                      IsChecked="True"
                      Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkIncludeRecording"
                      Content="Include session recording settings"
                      Foreground="#D4D4D4"
                      IsChecked="True"
                      Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkPreserveFolders"
                      Content="Preserve folder structure"
                      Foreground="#D4D4D4"
                      IsChecked="True"
                      Margin="0,0,0,14"/>

            <!-- Password Panel (visible for Encrypted .lcx) -->
            <StackPanel x:Name="PanelExportPassword">
                <TextBlock Text="EXPORT PASSWORD (AES-256-GCM)"
                           FontSize="11" FontWeight="SemiBold" Foreground="#007ACC"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Export password:" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="PwdExport" Grid.Row="0" Grid.Column="1"
                                 Background="#3C3C3C" Foreground="#D4D4D4" BorderBrush="#555555"
                                 Padding="6,4" PasswordChanged="PwdExport_PasswordChanged"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Confirm password:" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="PwdConfirm" Grid.Row="2" Grid.Column="1"
                                 Background="#3C3C3C" Foreground="#D4D4D4" BorderBrush="#555555"
                                 Padding="6,4"/>
                </Grid>

                <DockPanel>
                    <TextBlock x:Name="TxtStrengthLabel"
                               DockPanel.Dock="Right"
                               Text="Enter password"
                               Foreground="#858585"
                               FontSize="11"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BarPasswordStrength"
                                 Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="#2D2D2D"
                                 Foreground="#007ACC"
                                 BorderThickness="0"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
