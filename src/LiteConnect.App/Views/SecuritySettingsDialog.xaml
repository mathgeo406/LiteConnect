<Window x:Class="LiteConnect.App.Views.SecuritySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security &amp; Credential Encryption"
        Width="540" Height="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="🔐  Credential Vault &amp; Encryption Settings"
                   Foreground="#D4D4D4"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   x:Name="TxtModeSummary"
                   Foreground="#858585"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <CheckBox Grid.Row="2"
                  x:Name="ChkEnableMasterPassword"
                  Content="Enable Master Password (PBKDF2-SHA256, 100,000 iterations)"
                  Foreground="#D4D4D4"
                  FontSize="13"
                  Margin="0,0,0,12"
                  Checked="ChkEnableMasterPassword_Changed"
                  Unchecked="ChkEnableMasterPassword_Changed"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Current password box (shown when already in Master Password mode) -->
                <StackPanel x:Name="PanelCurrentPassword" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="Current Master Password" Foreground="#858585" FontSize="11" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="PwdCurrent"
                                 Background="#3C3C3C" Foreground="#D4D4D4"
                                 BorderBrush="#555555" BorderThickness="1"
                                 Padding="6,5" FontSize="13"/>
                </StackPanel>

                <!-- New + Confirm password + Strength meter -->
                <StackPanel x:Name="PanelNewPassword" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="LblNewPasswordHeader"
                               Text="SET NEW MASTER PASSWORD"
                               Foreground="#858585" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="New Master Password" Foreground="#858585" FontSize="11" Margin="0,0,0,3"/>
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="Confirm Master Password" Foreground="#858585" FontSize="11" Margin="0,0,0,3"/>

                        <PasswordBox x:Name="PwdNew" Grid.Column="0" Grid.Row="1"
                                     Background="#3C3C3C" Foreground="#D4D4D4"
                                     BorderBrush="#555555" BorderThickness="1"
                                     Padding="6,5" FontSize="13"
                                     PasswordChanged="PwdNew_PasswordChanged"/>
                        <PasswordBox x:Name="PwdConfirm" Grid.Column="2" Grid.Row="1"
                                     Background="#3C3C3C" Foreground="#D4D4D4"
                                     BorderBrush="#555555" BorderThickness="1"
                                     Padding="6,5" FontSize="13"/>
                    </Grid>

                    <!-- Password strength meter -->
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BarStrength"
                                     Grid.Column="0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Height="8"
                                     Background="#2D2D2D"
                                     BorderBrush="#3C3C3C"/>
                        <TextBlock x:Name="TxtStrength"
                                   Grid.Column="2"
                                   Text="Strength: —"
                                   Foreground="#858585"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Auto-lock configuration (Master Password mode only) -->
                <StackPanel x:Name="PanelAutoLock" Margin="0,6,0,0" Visibility="Collapsed">
                    <Separator Background="#3C3C3C" Margin="0,4,0,10"/>
                    <TextBlock Text="AUTO-LOCK (MASTER PASSWORD MODE)"
                               Foreground="#858585" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Auto-lock after idle (minutes):"
                                   Foreground="#D4D4D4" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtAutoLockMinutes"
                                 Width="70"
                                 Background="#3C3C3C" Foreground="#D4D4D4"
                                 CaretBrush="#D4D4D4"
                                 BorderBrush="#555555" BorderThickness="1"
                                 Padding="6,4" FontSize="13"/>
                        <Button x:Name="BtnLockNow"
                                Content="Lock Vault Now"
                                Margin="16,0,0,0"
                                Padding="12,4"
                                Background="#3C3C3C" Foreground="#D4D4D4"
                                BorderBrush="#555555" BorderThickness="1"
                                FontSize="12" Cursor="Hand"
                                Click="BtnLockNow_Click"/>
                    </StackPanel>

                    <TextBlock Text="Note: Locking Windows (Win+L) also locks the credential vault immediately."
                               Foreground="#858585" FontSize="11"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="4"
                   x:Name="TxtStatus"
                   Foreground="#FF6B6B"
                   FontSize="12"
                   Margin="0,8,0,8"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnSave"
                    Content="Apply &amp; Save"
                    Width="110" Height="30"
                    Margin="0,0,8,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="Transparent"
                    FontSize="13"
                    IsDefault="True"
                    Cursor="Hand"
                    Click="BtnSave_Click"/>
            <Button Content="Close"
                    Width="80" Height="30"
                    Background="#3C3C3C"
                    Foreground="#D4D4D4"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    FontSize="13"
                    IsCancel="True"
                    Cursor="Hand"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
