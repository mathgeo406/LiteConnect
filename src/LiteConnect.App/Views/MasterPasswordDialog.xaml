<Window x:Class="LiteConnect.App.Views.MasterPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock LiteConnect Vault"
        Width="420" Height="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="🔒  Enter Master Password"
                   Foreground="#D4D4D4"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   x:Name="TxtSubtitle"
                   Text="Your connection database is encrypted with a master password."
                   Foreground="#858585"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="PwdMaster"
                         Grid.Column="0"
                         Background="#3C3C3C"
                         Foreground="#D4D4D4"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         PasswordChanged="PwdMaster_PasswordChanged"/>

            <TextBox x:Name="TxtMasterRevealed"
                     Grid.Column="0"
                     Visibility="Collapsed"
                     Background="#3C3C3C"
                     Foreground="#D4D4D4"
                     CaretBrush="#D4D4D4"
                     BorderBrush="#555555"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="13"
                     TextChanged="TxtMasterRevealed_TextChanged"/>

            <ToggleButton x:Name="BtnReveal"
                          Grid.Column="2"
                          Content="👁"
                          ToolTip="Show / hide password"
                          Background="#3C3C3C"
                          Foreground="#D4D4D4"
                          BorderBrush="#555555"
                          BorderThickness="1"
                          Cursor="Hand"
                          Checked="BtnReveal_CheckedChanged"
                          Unchecked="BtnReveal_CheckedChanged"/>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="TxtError"
                   Foreground="#FF6B6B"
                   FontSize="12"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnUnlock"
                    Content="Unlock"
                    Width="90" Height="30"
                    Margin="0,0,8,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="Transparent"
                    FontSize="13"
                    IsDefault="True"
                    Cursor="Hand"
                    Click="BtnUnlock_Click"/>
            <Button Content="Exit"
                    Width="80" Height="30"
                    Background="#3C3C3C"
                    Foreground="#D4D4D4"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    FontSize="13"
                    IsCancel="True"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
