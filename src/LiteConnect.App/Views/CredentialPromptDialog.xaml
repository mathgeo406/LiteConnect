<Window x:Class="LiteConnect.App.Views.CredentialPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Credentials"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TxtHeader"
                   Text="🔑  Authentication Required"
                   Foreground="#D4D4D4"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   x:Name="TxtSubtitle"
                   Text="Enter credentials to connect to the remote host."
                   Foreground="#9E9E9E"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <!-- Username -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Username"
                       Foreground="#CCCCCC"
                       FontSize="12"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername"
                     Background="#3C3C3C"
                     Foreground="#D4D4D4"
                     CaretBrush="#D4D4D4"
                     BorderBrush="#555555"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="13"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Password"
                       Foreground="#CCCCCC"
                       FontSize="12"
                       Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="PwdBox"
                             Grid.Column="0"
                             Background="#3C3C3C"
                             Foreground="#D4D4D4"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             PasswordChanged="PwdBox_PasswordChanged"/>

                <TextBox x:Name="TxtPasswordRevealed"
                         Grid.Column="0"
                         Visibility="Collapsed"
                         Background="#3C3C3C"
                         Foreground="#D4D4D4"
                         CaretBrush="#D4D4D4"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         TextChanged="TxtPasswordRevealed_TextChanged"/>

                <ToggleButton x:Name="BtnReveal"
                              Grid.Column="2"
                              Content="👁"
                              ToolTip="Show / hide password"
                              Background="#3C3C3C"
                              Foreground="#D4D4D4"
                              BorderBrush="#555555"
                              BorderThickness="1"
                              Cursor="Hand"
                              Checked="BtnReveal_CheckedChanged"
                              Unchecked="BtnReveal_CheckedChanged"/>
            </Grid>
        </StackPanel>

        <!-- Optional Domain (for RDP) -->
        <StackPanel x:Name="PnlDomain"
                    Grid.Row="4"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
            <TextBlock Text="Domain (optional)"
                       Foreground="#CCCCCC"
                       FontSize="12"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDomain"
                     Background="#3C3C3C"
                     Foreground="#D4D4D4"
                     CaretBrush="#D4D4D4"
                     BorderBrush="#555555"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="13"/>
        </StackPanel>

        <!-- Validation Error -->
        <TextBlock Grid.Row="5"
                   x:Name="TxtError"
                   Foreground="#FF6B6B"
                   FontSize="12"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0">
            <Button x:Name="BtnConnect"
                    Content="Connect"
                    Width="95" Height="30"
                    Margin="0,0,8,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="Transparent"
                    FontSize="13"
                    IsDefault="True"
                    Cursor="Hand"
                    Click="BtnConnect_Click"/>
            <Button Content="Cancel"
                    Width="80" Height="30"
                    Background="#3C3C3C"
                    Foreground="#D4D4D4"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    FontSize="13"
                    IsCancel="True"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
