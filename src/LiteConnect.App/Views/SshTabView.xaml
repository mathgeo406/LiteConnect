<UserControl x:Class="LiteConnect.App.Views.SshTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LiteConnect.App.Converters"
             Background="#1E1E1E"
             DataContextChanged="SshTabView_DataContextChanged"
             Unloaded="SshTabView_Unloaded">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="SshToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Compact SSH Session Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy"
                            Style="{StaticResource SshToolbarButtonStyle}"
                            Command="{Binding CopySelectionCommand}"
                            ToolTip="Copy selected text (Ctrl+Shift+C)"/>
                    <Button Content="Paste"
                            Style="{StaticResource SshToolbarButtonStyle}"
                            Command="{Binding PasteClipboardCommand}"
                            ToolTip="Paste from clipboard (Right-Click / Ctrl+Shift+V)"/>
                    <Button Content="Clear"
                            Style="{StaticResource SshToolbarButtonStyle}"
                            Command="{Binding ClearTerminalCommand}"
                            ToolTip="Clear terminal screen and scrollback"/>
                    <Button Content="Reconnect"
                            Style="{StaticResource SshToolbarButtonStyle}"
                            Command="{Binding ReconnectCommand}"
                            Visibility="{Binding IsDisconnectedOrError, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Disconnect"
                            Style="{StaticResource SshToolbarButtonStyle}"
                            Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#9E9E9E"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- TerminalControl Host Container -->
        <Border x:Name="TerminalHostContainer"
                Background="#1E1E1E"
                ClipToBounds="True"/>
    </DockPanel>
</UserControl>
